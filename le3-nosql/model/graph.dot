// graph.dot
// Property-Graph-Modell der Neo4j-Umsetzung: Knoten mit Label und Eigenschaften,
// gerichtete Kanten mit Typ. Deutsche Namen wie im konzeptionellen Modell,
// darunter das Label wie in den Cypher-Skripten.
// id ist bei jedem Label eindeutig (schema.cypher).
// COMPLETED ist eine abgeleitete Abkuerzung vom Abschluss direkt zum Kurs.
// Rendern: dot -Tpng graph.dot -o graph.png
digraph graph_model {
  graph [rankdir=LR, pad=0.3, nodesep=0.6, ranksep=1.3, bgcolor="white"];
  node  [shape=ellipse, style=filled, fontname="Helvetica", fontsize=11, penwidth=1.2];
  edge  [fontname="Helvetica", fontsize=10, penwidth=1.2, color="#333333"];

  learner  [label=<<B>Studi</B><BR/><FONT POINT-SIZE="9">:Learner</FONT><BR/><FONT POINT-SIZE="9">id, name, study_mode</FONT>>, fillcolor="#f6c85f"];
  run      [label=<<B>Durchführung</B><BR/><FONT POINT-SIZE="9">:Run</FONT><BR/><FONT POINT-SIZE="9">id, study_mode</FONT>>, fillcolor="#8cc63f"];
  course   [label=<<B>Kurs</B><BR/><FONT POINT-SIZE="9">:Course</FONT><BR/><FONT POINT-SIZE="9">id, title, hours</FONT>>, fillcolor="#2ec4d0"];
  semester [label=<<B>Semester</B><BR/><FONT POINT-SIZE="9">:Semester</FONT><BR/><FONT POINT-SIZE="9">id, name, starts_on, ends_on</FONT>>, fillcolor="#d9d9d9"];
  location [label=<<B>Standort</B><BR/><FONT POINT-SIZE="9">:Location</FONT><BR/><FONT POINT-SIZE="9">id, name</FONT>>, fillcolor="#d9d9d9"];
  lecturer [label=<<B>Lehrperson</B><BR/><FONT POINT-SIZE="9">:Lecturer</FONT><BR/><FONT POINT-SIZE="9">id, name</FONT>>, fillcolor="#d9d9d9"];

  learner -> run      [label="schliesst ab\n{completed_on}"];
  learner -> course   [label="hat abgeschlossen (abgeleitet)\n{completed_on}", style=dashed];
  run -> course       [label="gehört zu"];
  run -> semester     [label="findet statt in"];
  run -> location     [label="findet statt an"];
  lecturer -> run     [label="unterrichtet"];
  course -> course    [label="setzt voraus\n(Zielkurs -> Vorkurs)"];

  {rank=same; learner; lecturer;}
  {rank=same; course; semester; location;}
}
