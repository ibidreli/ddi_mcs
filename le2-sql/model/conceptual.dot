// conceptual.dot
// Konzeptionelles Datenmodell (ERD) in Chen-Notation, Variante V2 mit sechs Entitaetstypen.
// Entitaetstypen als Rechtecke, Beziehungstypen als Rauten, Attribute als Ellipsen,
// Schluesselattribute unterstrichen, Kardinalitaeten 1/N an den Kanten.
// Eine Beziehung mit eigenem Attribut ist als assoziative Entitaet (Raute im Rechteck) gezeichnet.
// Rendern: neato -n2 -Tpng conceptual.dot -o conceptual.png
graph conceptual {
  graph [splines=true, outputorder=edgesfirst, pad=0.3, bgcolor="white"];
  node  [fontname="Helvetica", fontsize=12, style=filled, penwidth=1.2];
  edge  [fontname="Helvetica", fontsize=12, penwidth=1.2];

  // Entitaetstypen
  node [shape=box, fillcolor="#2ec4d0", width=1.6, height=0.55];
  kurs     [label="Kurs",            pos="560,470!"];
  durch    [label="Durchführung",    pos="560,250!"];
  semester [label="Semester",        pos="230,250!"];
  standort [label="Standort",        pos="890,250!"];
  lehr     [label="Lehrperson",      pos="560,40!"];
  person   [label="Lernende Person", pos="140,470!"];

  // Assoziative Entitaet "belegt" (Raute im Rechteck)
  belegt_box [shape=box, label="", fillcolor="white", width=1.5, height=0.75, pos="300,380!"];
  belegt     [shape=diamond, label="belegt", fillcolor="#8cc63f", width=1.35, height=0.65, pos="300,380!"];

  // Beziehungstypen
  node [shape=diamond, fillcolor="#8cc63f", width=1.55, height=0.65];
  voraus    [label="setzt voraus",   pos="560,610!"];
  angeboten [label="wird\nangeboten als", pos="560,360!"];
  in_sem    [label="findet\nstatt in",    pos="395,250!"];
  an_ort    [label="findet\nstatt an",    pos="725,250!"];
  unterr    [label="unterrichtet",   pos="560,145!"];

  // Attribute
  node [shape=ellipse, fillcolor="white", fontsize=11, height=0.4, width=0.9];
  k_code  [label=<<U>Kurscode</U>>, pos="720,520!"];
  k_titel [label="Titel",           pos="740,470!"];
  k_std   [label="Stunden",         pos="720,420!"];
  d_nr    [label=<<U>Nr</U>>,       pos="700,175!"];
  d_form  [label="Studienform",     pos="700,325!"];
  s_id    [label=<<U>Semester-ID</U>>, pos="110,190!"];
  s_beg   [label="Beginn",          pos="230,175!"];
  s_end   [label="Ende",            pos="340,175!"];
  o_id    [label=<<U>ID</U>>,       pos="890,330!"];
  o_name  [label="Name",            pos="890,170!"];
  l_id    [label=<<U>ID</U>>,       pos="400,40!"];
  l_name  [label="Name",            pos="720,40!"];
  p_id    [label=<<U>ID</U>>,       pos="40,540!"];
  p_name  [label="Anzeigename",     pos="150,560!"];
  p_form  [label="Studienform",     pos="270,540!"];
  b_dat   [label="Abschlussdatum\n(leer = läuft)", pos="130,330!"];

  kurs -- k_code; kurs -- k_titel; kurs -- k_std;
  durch -- d_nr; durch -- d_form;
  semester -- s_id; semester -- s_beg; semester -- s_end;
  standort -- o_id; standort -- o_name;
  lehr -- l_id; lehr -- l_name;
  person -- p_id; person -- p_name; person -- p_form;
  belegt_box -- b_dat;

  // Beziehungen mit Kardinalitaeten
  kurs:nw -- voraus:w [taillabel="N", labeldistance=1.8, labelangle=-40, xlabel="als Zielkurs"];
  kurs:ne -- voraus:e [taillabel="N", labeldistance=1.8, labelangle=40, xlabel="als Vorkurs"];
  kurs -- angeboten [taillabel="1", labeldistance=1.6, labelangle=30];
  angeboten -- durch [headlabel="N", labeldistance=1.6, labelangle=-30];
  semester -- in_sem [taillabel="1", labeldistance=1.6, labelangle=30];
  in_sem -- durch [headlabel="N", labeldistance=1.6, labelangle=-30];
  standort -- an_ort [taillabel="1", labeldistance=1.6, labelangle=-30];
  an_ort -- durch [headlabel="N", labeldistance=1.6, labelangle=30];
  lehr -- unterr [taillabel="1", labeldistance=1.6, labelangle=30];
  unterr -- durch [headlabel="N", labeldistance=1.6, labelangle=-30];
  person -- belegt_box [taillabel="N", labeldistance=2.2, labelangle=-45];
  belegt_box -- durch [headlabel="N", labeldistance=2.4, labelangle=-35];
}
